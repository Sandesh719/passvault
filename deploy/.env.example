# Copy to `.env` and fill both in before `docker compose up -d`.

# The hostname devices will type into PassVault's "Connection server" box.
# Its DNS A/AAAA record must already point at this machine, or the certificate
# cannot be issued.
PASSVAULT_DOMAIN=sync.example.org

# Let's Encrypt sends expiry warnings here if renewal ever stops working.
ACME_EMAIL=you@example.org

# Only needed if you use a free DuckDNS name and start the updater with
#   docker compose --profile duckdns up -d
# The subdomain is the bare label: for foo.duckdns.org, put `foo`.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
