node_modules/
dist/
# electron-vite compiles here, and electron-builder writes installers here.
# Committing them put 874 MB of Electron binaries in the first commit and got
# the push rejected outright.
out/
release/
coverage/
.vitest/
*.tsbuildinfo
.DS_Store
*.log

# Environment/local config
.env
.env.*
!.env.example

# Package manager/runtime caches
.npm/
.pnpm-store/
.yarn/
.vite/
.turbo/

# Frontend/mobile build outputs
frontend/.vite/
frontend/.capacitor/
frontend/android/
frontend/ios/
# The Android project is source, not output: it carries the Gradle setup and
# the native plugin that reaches the Storage Access Framework and the
# keystore. A blanket android/ rule written before that project existed would
# have silently dropped all of it — the same way build/ once swallowed the
# mac entitlements file. Capacitor's own android/.gitignore excludes the
# genuine build products, and .gradle/ and build/ below catch the rest.

# Native/mobile IDE outputs
*.iml
.gradle/
build/
# ...but the desktop app's build/ holds signing resources that are source, not
# output. Without this the mac build fails on a fresh clone with a missing
# entitlements file, which reads as a signing problem rather than a git one.
!apps/desktop/build/
!apps/desktop/build/**
# ...but the re-inclusion above would otherwise drag Finder metadata back in
# with the signing resources.
apps/desktop/build/.DS_Store
DerivedData/

# Local vault/test artifacts
*.kdbx
*.kdbx.tmp
*.kdbx.backup

# Pre-M1 UI kept only as a reference while the desktop shell is rebuilt
.attic/

# Two-device sandbox: profiles and sample vaults
.sandbox/

# Android signing. The keystore is a credential and the passwords beside it
# are too; both stay on the machine that holds them and in CI secrets.
*.jks
*.keystore
apps/mobile/android/keystore.properties
