{
  "name": "passvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "signaling": "pnpm --filter @passvault/signaling dev",
    "desktop": "pnpm --filter @passvault/desktop dev",
    "desktop:build": "pnpm --filter @passvault/desktop build",
    "demo": "pnpm --filter @passvault/demo start",
    "two": "node scripts/two-devices.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}