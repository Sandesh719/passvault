{
  "name": "@passvault/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "package:win": "electron-vite build && electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "@passvault/core": "workspace:*",
    "@passvault/identity": "workspace:*",
    "@passvault/kdbx": "workspace:*",
    "@passvault/storage-node": "workspace:*",
    "@passvault/sync": "workspace:*",
    "@passvault/transport": "workspace:*",
    "chokidar": "^5.0.0",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "node-sqlite3-wasm": "^0.8.60"
  },
  "devDependencies": {
    "@passvault/signaling": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "description": "Keeps one KeePass vault in step across your devices, peer to peer.",
  "author": "PassVault"
}
